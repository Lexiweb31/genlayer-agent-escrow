{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://genlayer.example/schemas/agent-escrow/rubric.schema.json",
  "title": "Agent Escrow Rubric",
  "description": "One to eight immutable criteria. Criterion IDs must be unique and weight_bps must total exactly 10000; those cross-item constraints are enforced by the contract.",
  "type": "array",
  "minItems": 1,
  "maxItems": 8,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "requirement", "weight_bps"],
    "properties": {
      "id": {"type": "integer", "minimum": 1, "maximum": 4294967295},
      "requirement": {"type": "string", "minLength": 1},
      "weight_bps": {"type": "integer", "minimum": 1, "maximum": 10000},
      "evidence_guidance": {"type": "string", "default": ""}
    }
  }
}
