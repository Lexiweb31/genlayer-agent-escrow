{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://genlayer.example/schemas/agent-escrow/evidence-policy.schema.json",
  "title": "Agent Escrow Evidence Policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["allowed_kinds", "require_url_hashes", "requirements"],
  "properties": {
    "allowed_kinds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {"enum": ["TEXT", "URL"]}
    },
    "require_url_hashes": {"type": "boolean"},
    "requirements": {"type": "string", "maxLength": 4096}
  }
}
